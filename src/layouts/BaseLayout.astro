---
import { ClientRouter } from 'astro:transitions'
import BaseHead from '@/components/seo/BaseHead.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import { getSiteSettings } from '@/lib/microcms'
import { buildWebSiteSchema } from '@/lib/schema'
import type { SEOProps } from '@/types'
import '@/styles/global.css'

interface Props extends SEOProps {
  class?: string
  /** Set false on pages that need a guaranteed full page load (e.g. the Turnstile form). */
  clientRouter?: boolean
}

const {
  title,
  description,
  ogImage,
  canonical,
  noindex = false,
  class: className,
  clientRouter = true,
} = Astro.props

const settings = await getSiteSettings()
const webSiteSchema = buildWebSiteSchema()

// Old page fades and rises out; the new page's content unmasks through the reveal system.
const pageAnimation = {
  forwards: {
    old: { name: 'bk-page-out', duration: '220ms', easing: 'cubic-bezier(.65,0,.35,1)', fillMode: 'both' },
    new: { name: 'bk-page-in', duration: '360ms', easing: 'cubic-bezier(.16,1,.3,1)', delay: '120ms', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'bk-page-out', duration: '220ms', easing: 'cubic-bezier(.65,0,.35,1)', fillMode: 'both' },
    new: { name: 'bk-page-in', duration: '360ms', easing: 'cubic-bezier(.16,1,.3,1)', delay: '120ms', fillMode: 'both' },
  },
}
---

<!doctype html>
<html lang="ja" transition:animate="none">
  <head>
    <BaseHead
      title={title}
      description={description || settings.siteDescription}
      ogImage={ogImage || settings.defaultOgImage?.url}
      canonical={canonical}
      noindex={noindex}
      gaMeasurementId={settings.gaMeasurementId}
      gscVerificationCode={settings.gscVerificationCode}
    />
    <JsonLd schemas={[webSiteSchema]} />
    {clientRouter && <ClientRouter fallback="swap" />}
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col font-sans text-[var(--color-ink-violet)]">
    <div id="top"></div>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <div class="intro" aria-hidden="true">
      <span class="intro__mark">bykamo.dev</span>
      <div class="intro__row">
        <span class="intro__count" data-intro-count>000</span>
        <span>REASSEMBLING — AI × CODE</span>
      </div>
    </div>

    <div class="site-header-slot" transition:persist="site-header" transition:animate="none">
      <Header xUrl={settings.xurl} githubUrl={settings.githubUrl} />
    </div>

    <main id="main" class:list={['site-main flex-1', className]} transition:animate={pageAnimation}>
      <div class="page-enter">
        <slot />
      </div>
    </main>

    <div class="site-footer-slot" transition:animate={pageAnimation}>
      <Footer xUrl={settings.xurl} githubUrl={settings.githubUrl} />
    </div>

    <script>
      import '@/scripts/motion/index.ts'
    </script>
  </body>
</html>

<style is:global>
  /* view-transition-name makes these stacking contexts: lift the persisted header slot above main. */
  .site-header-slot { position: relative; z-index: 50; }
  .site-main { padding-top: var(--header-h); }
  .site-main.page-flush + .site-footer-slot .site-footer { margin-top: 0; }
</style>
