---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import PageHero from '@/components/ui/PageHero.astro'
import RevealLines from '@/components/ui/RevealLines.astro'
import ContactCta from '@/components/sections/ContactCta.astro'
import Statement from '@/components/about/Statement.astro'
import FactSheet from '@/components/about/FactSheet.astro'
import FocusRows from '@/components/about/FocusRows.astro'
import ProcessLine from '@/components/about/ProcessLine.astro'
import ExploreList from '@/components/about/ExploreList.astro'
import { getBuilds, getNotes, getSiteSettings } from '@/lib/microcms'
import { buildProfilePageSchema } from '@/lib/schema'

const [{ contents: featuredBuilds }, { contents: featuredNotes }, settings] = await Promise.all([
  getBuilds({ featured: true, limit: 3 }),
  getNotes({ featured: true, limit: 3 }),
  getSiteSettings(),
])
const profileSchema = buildProfilePageSchema()

const statement = [
  { text: 'KAMOは、' }, { text: 'AIとコードを使って、' }, { text: '情報の扱い方と' }, { text: 'プロダクトの動き方を' },
  { text: '組み直す', marker: true }, { text: '開発者です。' }, { text: '見た目だけでなく、' }, { text: '判断の流れと' },
  { text: '運用まで含めて' }, { text: '設計します。' },
]

const skills = [
  { icon: 'brain' as const, label: 'AI実装', text: 'LLM、OCR、自動生成、RAG、画像認識の実装と運用設計。' },
  { icon: 'gear' as const, label: '自動化', text: '取引bot、配信、自動ワークフローの設計と継続運用。' },
  { icon: 'code' as const, label: 'Web開発', text: 'Astro、Next.js、React、TypeScript、Cloudflareを軸に構築。' },
  { icon: 'chart' as const, label: 'Web3 / DeFi', text: '予測市場、DEX、データ監視系の実験と実装。' },
]

const facts = [
  { k: 'NAME', v: 'KAMO' },
  { k: 'ROLE', v: 'Independent developer' },
  { k: 'BASE', v: 'Tokyo, JP' },
  { k: 'FOCUS', v: 'AI実装・自動化・Web開発・Web3' },
  { k: 'STACK', v: 'Astro / Next.js / React / TypeScript / Cloudflare' },
  { k: 'AI', v: 'LLM / OCR / RAG / 画像認識' },
]

const socials = [
  settings.xurl ? { label: 'X', href: settings.xurl } : undefined,
  settings.githubUrl ? { label: 'GitHub', href: settings.githubUrl } : undefined,
].filter((item): item is { label: string; href: string } => Boolean(item))

const steps = [
  { word: '整理', en: 'Sort', caption: '今ある情報から、次の一手を整理する。' },
  { word: '設計', en: 'Design', caption: '見た目だけでなく、判断の流れまで設計する。' },
  { word: '実装', en: 'Build', caption: '単発のデモではなく、現実の導線に載せる。' },
  { word: '運用', en: 'Operate', caption: '最後の運用フェーズまで、切らさずつなぐ。' },
]

const buildItems = featuredBuilds.map((build) => ({ href: `/builds/${build.slug}`, title: build.title }))
const noteItems = featuredNotes.map((note) => ({ href: `/notes/${note.slug}`, title: note.title }))
---

<BaseLayout title="About" description="KAMOについて。AIとコードで、情報・運用・体験を組み直す開発者。" class="page-flush">
  <Fragment slot="head"><JsonLd schemas={[profileSchema]} /></Fragment>

  <div class="section-shell about-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />

    <PageHero
      index="03"
      label="ABOUT"
      lines={['実装と運用のあいだを、', { text: '切らさずつなぐ。', marker: 'つなぐ' }]}
      meta={[{ k: 'ROLE', v: 'INDEPENDENT DEVELOPER' }, { k: 'BASE', v: 'TOKYO, JP' }]}
      class="about-hero"
    />

    <section class="about-block about-statement" aria-label="ステートメント">
      <Statement label="(03.1) — STATEMENT" phrases={statement} />
    </section>

    <div class="about-block about-profile grid-12">
      <div class="about-profile__rail">
        <FactSheet facts={facts} socials={socials} />
      </div>

      <div class="about-profile__main">
        <section class="about-profile__copy" aria-labelledby="about-profile-title">
          <h2 id="about-profile-title" class="annotation" data-reveal>(03.2) — PROFILE</h2>
          <div class="body-text-lg about-profile__text" data-reveal style="--delay:80ms;">
            <p>取引bot・自動化システム・Webアプリ・PWAなど、課題に合わせてプロダクトを設計し、最後の運用フェーズまで実装します。</p>
            <p>専門領域は、LLM・OCR・リアルタイムデータ処理といったAI技術を、単発のデモではなく現実の導線に載せることです。</p>
            <p>成果物は <a href="/builds" class="link-draw">Builds</a> に、設計判断や比較メモは <a href="/notes" class="link-draw">Notes</a> に整理しています。</p>
          </div>
        </section>

        <section class="about-focus" aria-labelledby="about-focus-title">
          <h2 id="about-focus-title" class="annotation" data-reveal>(03.3) — FOCUS</h2>
          <FocusRows rows={skills} />
        </section>
      </div>
    </div>

    <section class="about-block about-process" aria-labelledby="about-process-title">
      <div class="about-process__head grid-12">
        <p class="annotation about-process__label" data-reveal>(03.4) — PROCESS</p>
        <RevealLines as="h2" id="about-process-title" class="about-process__title" lines={['課題の整理から', '設計、実装、運用まで。']} />
      </div>
      <ProcessLine steps={steps} label="進め方" />
    </section>

    {(buildItems.length > 0 || noteItems.length > 0) && (
      <section class="about-block about-explore" aria-labelledby="about-explore-title">
        <h2 id="about-explore-title" class="annotation" data-reveal>(03.5) — EXPLORE</h2>
        <span class="rule about-explore__rule" data-reveal="rule" aria-hidden="true"></span>
        <div class="about-explore__columns">
          {buildItems.length > 0 && <ExploreList kicker="BUILDS" heading="代表的なBuilds" items={buildItems} more={{ href: '/builds', label: 'Buildsへ' }} />}
          {noteItems.length > 0 && <ExploreList kicker="NOTES" heading="設計の裏側にあるNotes" items={noteItems} more={{ href: '/notes', label: 'Notesへ' }} />}
        </div>
      </section>
    )}
  </div>

  <ContactCta />
</BaseLayout>

<style>
  .about-page { padding-block: clamp(24px, 4vw, 56px) var(--section-gap); }
  .about-block { margin-top: clamp(80px, 9vw, 144px); }
  .about-statement { margin-top: clamp(40px, 4vw, 64px); }

  .about-profile { row-gap: 56px; align-items: start; }
  .about-profile__rail,
  .about-profile__main { grid-column: 1 / -1; }
  .about-profile__main { display: grid; gap: clamp(64px, 7vw, 112px); }

  .about-profile__copy,
  .about-focus { display: grid; gap: 28px; }
  .about-profile__text { display: grid; gap: 1.1em; max-width: 36em; }
  .about-profile__text .link-draw { display: inline; font-size: inherit; padding-bottom: 2px; }

  .about-process__head { row-gap: 20px; margin-bottom: clamp(48px, 6vw, 88px); }
  .about-process__label { grid-column: 1 / -1; }
  .about-process__head > :global(.about-process__title) {
    grid-column: 1 / -1;
    font-size: var(--text-display);
    font-weight: 700;
    font-feature-settings: "palt";
    letter-spacing: -0.01em;
    line-height: 1.16;
  }

  .about-explore { display: grid; gap: 20px; }
  .about-explore__rule { width: 100%; }
  .about-explore__columns { display: grid; gap: 64px; margin-top: 20px; }

  @media (min-width: 900px) {
    .about-profile__rail { grid-column: 1 / 5; position: sticky; top: calc(var(--header-h) + 24px); }
    .about-profile__main { grid-column: 6 / 13; }
    .about-process__label { grid-column: 1 / 4; padding-top: 1.2em; }
    .about-process__head > :global(.about-process__title) { grid-column: 4 / 13; }
    .about-explore__columns { grid-template-columns: 1fr 1fr; column-gap: clamp(32px, 4vw, 64px); }
  }

  @media (max-width: 599px) {
    .about-process__head > :global(.about-process__title) { font-size: clamp(26px, 7.6vw, 36px); }
  }

  @media (min-width: 600px) and (max-width: 899px) {
    .about-profile__rail { max-width: 460px; }
  }
</style>
