---
import '@/styles/contact-form.css'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'
import RevealLines from '@/components/ui/RevealLines.astro'
import FormSteps from '@/components/contact/FormSteps.astro'
import FormSuccess from '@/components/contact/FormSuccess.astro'
import ModeSwitch from '@/components/contact/ModeSwitch.astro'
import ChatPanel from '@/components/contact/ChatPanel.astro'
import SummaryPanel from '@/components/contact/SummaryPanel.astro'
import DirectFields from '@/components/contact/DirectFields.astro'
import ContactFields from '@/components/contact/ContactFields.astro'
import TurnstileWidget from '@/components/contact/TurnstileWidget.astro'
import { CATEGORIES } from '@/lib/contact-schema'
import { TURNSTILE_TEST_KEYS } from '@/lib/contact/turnstile'

// A real site key refuses localhost, so `astro dev` runs on Cloudflare's test pair (see _secrets.ts).
const siteKey = import.meta.env.DEV ? TURNSTILE_TEST_KEYS.siteKey : import.meta.env.TURNSTILE_SITE_KEY
---

<BaseLayout title="お問い合わせフォーム" description="AI実装・自動化・プロダクト開発のご相談フォーム。AI と話しながら相談内容を整理できます。" clientRouter={false}>
  <Fragment slot="head">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  </Fragment>

  <div class="section-shell form-page">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Contact', href: '/contact' },
      { label: 'Form' },
    ]} />

    <div class="form-page__grid">
      <div class="form-page__intro">
        <div class="form-page__sticky">
          <p class="annotation" data-reveal>(04) — CONTACT FORM</p>
          <RevealLines as="h1" class="form-page__title" lines={[{ text: 'お問い合わせ', marker: true }]} delay={80} />
          <span class="rule" data-reveal="rule" style="--delay:200ms;" aria-hidden="true"></span>
          <p class="body-text-lg form-page__lead" data-reveal style="--delay:160ms;">AI と話しながら、相談内容を整理できます。まとまったら連絡先を添えて送信してください。</p>
          <FormSteps />
        </div>
      </div>

      <div class="form-page__main">
        <div id="form-container" class="glass-panel form-panel reveal" data-reveal data-mode="chat">
          <div class="form-panel__bar" aria-hidden="true"><span id="panel-bar-left">CHAT — 01 / 03 TALK</span><span id="panel-bar-right">AI ASSISTED</span></div>
          <ModeSwitch />
          <p id="panel-notice" class="panel-notice hidden" role="status" aria-live="polite"></p>

          <ChatPanel />

          <form id="contact-form" class="hidden" novalidate>
            <div class="form-panel__fields">
              <div class="field">
                <label for="category" class="form-label"><span>ご相談の種類</span><span class="form-tag" aria-hidden="true">REQUIRED</span></label>
                <select id="category" name="category" required aria-describedby="category-error" class="form-input form-select">
                  <option value="" disabled selected>選択してください</option>
                  {CATEGORIES.map((cat) => (
                    <option value={cat.value}>{cat.label}</option>
                  ))}
                </select>
                <p class="form-error" id="category-error" data-error="category"></p>
              </div>

              <SummaryPanel />
              <DirectFields />
              <ContactFields />

              <!-- Honeypot -->
              <div aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;">
                <label for="_honey">Do not fill this</label>
                <input type="text" id="_honey" name="_honey" tabindex="-1" autocomplete="off" />
              </div>

              <div id="form-alert" class="form-alert hidden" aria-live="polite"></div>

              <div class="form-panel__submit">
                <button type="submit" id="submit-btn" class="btn-primary form-submit">
                  送信する
                </button>
                <p class="form-panel__note annotation" aria-hidden="true">SECURED BY TURNSTILE</p>
              </div>
            </div>
          </form>

          <TurnstileWidget siteKey={siteKey} />
        </div>

        <FormSuccess />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '@/scripts/contact/index'
</script>
