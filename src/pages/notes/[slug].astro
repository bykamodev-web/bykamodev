---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'
import BuildFeature from '@/components/cards/BuildFeature.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import ArticleHero from '@/components/article/ArticleHero.astro'
import Toc from '@/components/article/Toc.astro'
import TopicChips from '@/components/article/TopicChips.astro'
import NoteList from '@/components/article/NoteList.astro'
import IndexReturn from '@/components/article/IndexReturn.astro'
import ContactCta from '@/components/sections/ContactCta.astro'
import { getAllNoteSlugs, getNoteBySlug, getOptimizedImageUrl } from '@/lib/microcms'
import { buildNotePageSchemas } from '@/lib/schema'
import { embedYouTube } from '@/lib/embeds'
import { extractHeadings, withHeadingIds } from '@/components/article/headings'
import { formatDotDate, kindLabel } from '@/components/article/format'

export async function getStaticPaths() {
  const slugs = await getAllNoteSlugs()
  return slugs.map((item) => ({ params: { slug: item.slug }}))
}

const { slug } = Astro.params
const note = await getNoteBySlug(slug)
if (!note) return Astro.redirect('/404')

const schemas = buildNotePageSchemas(note)
const ogImage = note.seoMeta?.ogImage?.url || note.coverImage?.url
const kind = kindLabel(note.kind?.[0])
const published = formatDotDate(note.publishedAt)
const updated = note.updatedAt ? formatDotDate(note.updatedAt) : ''
const cover = note.coverImage
  ? (width: number) => getOptimizedImageUrl(note.coverImage!.url, { width, quality: 82, aspectRatio: '16:9' })
  : null
const body = withHeadingIds(embedYouTube(note.body))
const headings = extractHeadings(body)
const readMinutes = Math.max(1, Math.round(body.replace(/<[^>]+>/g, '').length / 600))
const relatedBuilds = note.relateBuilds || []
const relatedNotes = note.relatedNotes || []
---

<BaseLayout class="page-flush" title={note.seoMeta?.metaTitle || note.title} description={note.seoMeta?.metaDescription || note.excerpt} ogImage={ogImage} noindex={note.seoMeta?.noIndex}>
  <Fragment slot="head"><JsonLd schemas={schemas} /></Fragment>
  <article class="note-page">
    <div class="section-shell">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Notes', href: '/notes' }, { label: note.title }]} />
      <ArticleHero
        index="02"
        label={`NOTES / ${kind.toUpperCase()}`}
        title={note.title}
        lead={note.excerpt}
        meta={[
          { k: 'PUBLISHED', v: published },
          ...(updated && updated !== published ? [{ k: 'UPDATED', v: updated }] : []),
          { k: 'READ', v: `${readMinutes} MIN` },
        ]}
      >
        <TopicChips topics={note.topics} />
      </ArticleHero>

      {cover && (
        <figure class="article-cover note-cover">
          <div class="article-cover__clip" data-reveal="clip">
            <div class="article-cover__media">
              <img
                src={cover(1440)}
                srcset={[960, 1440, 2000].map((width) => `${cover(width)} ${width}w`).join(', ')}
                sizes="(max-width: 1400px) 94vw, 1320px"
                alt={note.title}
                width="1440"
                height="810"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </figure>
      )}

      <div class="note-body">
        <div class="note-body__rail"><Toc headings={headings} /></div>
        <div class="note-body__main">
          <div class="rich-content" set:html={body} />
          <div class="note-end" aria-hidden="true"><span></span><span></span><span></span></div>
          <p class="note-end__meta annotation">END OF NOTE — {published}</p>
        </div>
      </div>

      {relatedBuilds.length > 0 && (
        <section class="note-related" aria-labelledby="note-related-builds">
          <div class="note-related__head" data-reveal>
            <h2 id="note-related-builds" class="annotation">RELATED BUILDS — 関連する制作</h2>
          </div>
          <div class="note-related__builds">
            {relatedBuilds.map((build, index) => <BuildFeature build={build} index={index} reverse={index % 2 === 1} headingLevel="h3" />)}
          </div>
        </section>
      )}

      {relatedNotes.length > 0 && (
        <section class="note-related" aria-labelledby="note-related-notes">
          <div class="note-related__head" data-reveal>
            <h2 id="note-related-notes" class="annotation">RELATED NOTES — あわせて読む</h2>
          </div>
          <NoteList notes={relatedNotes} headingLevel="h3" />
        </section>
      )}
    </div>

    <IndexReturn href="/notes" label="BACK TO INDEX — NOTES" title="ほかのNotesを読む" />
    <div class="note-page__cta"><ContactCta /></div>
  </article>
</BaseLayout>

<style>
  .note-page { padding-top: clamp(40px, 6vw, 80px); }

  .note-cover { margin-top: clamp(48px, 6vw, 88px); }

  .note-body {
    display: grid;
    gap: 32px;
    margin-top: clamp(48px, 6vw, 96px);
  }
  .note-body__main { min-width: 0; }

  .note-end { display: flex; gap: 8px; margin-top: 72px; }
  .note-end span { width: 10px; height: 10px; border: 1px solid var(--color-ink-violet); background: var(--color-butter-yellow); }
  .note-end span:nth-child(2) { background: var(--color-pure-white); }
  .note-end__meta { margin-top: 16px; opacity: 0.72; }

  .note-related { margin-top: clamp(80px, 10vw, 144px); }
  .note-related__head { margin-bottom: 16px; }
  .note-related__builds { border-bottom: 1px solid var(--color-ink-violet); }

  .note-page__cta { margin-top: clamp(80px, 10vw, 160px); }

  @media (min-width: 1100px) {
    .note-body { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 32px); }
    .note-body__rail { grid-column: 1 / 4; }
    .note-body__main { grid-column: 5 / 13; }
  }

</style>
