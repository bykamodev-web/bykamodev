---
import BaseLayout from '@/layouts/BaseLayout.astro'
import NoteCard from '@/components/cards/NoteCard.astro'
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import { getNotes } from '@/lib/microcms'
import { buildCollectionPageSchema } from '@/lib/schema'

const { contents: notes } = await getNotes()

const collectionSchema = buildCollectionPageSchema({
  name: 'Notes',
  description: '開発ログ・設計メモ・技術記事',
  url: 'https://bykamo.dev/notes',
})
---

<BaseLayout title="Notes" description="開発ログ・設計メモ・技術記事。設計判断の記録。">
  <Fragment slot="head">
    <JsonLd schemas={[collectionSchema]} />
  </Fragment>

  <div class="section-shell collection-page">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Notes' },
    ]} />

    <p class="section-label">NOTES</p>
    <h1 class="page-title">設計の途中経過を、捨てずに残す。</h1>
    <p class="body-text-lg collection-page__lead">開発ログ、設計メモ、技術記事。あとから見返しても使える粒度で、判断の履歴を保存しています。</p>

    {notes.length > 0 ? (
      <div class="collection-grid">
        {notes.map((note, index) => (
          <div class="reveal" data-reveal style={`--delay:${index * 70}ms;`}>
            <NoteCard note={note} />
          </div>
        ))}
      </div>
    ) : (
      <p class="body-text">まだ公開されたNotesはありません。</p>
    )}
  </div>
</BaseLayout>

<style>
  .collection-page { padding-block: 80px 120px; }
  .section-label { margin-bottom: 16px; }
  .page-title { max-width: 760px; }
  .collection-page__lead { max-width: 680px; margin-top: 24px; margin-bottom: 64px; }
  .collection-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 768px) { .collection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .collection-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
