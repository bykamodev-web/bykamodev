---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'
import BuildCard from '@/components/cards/BuildCard.astro'
import NoteCard from '@/components/cards/NoteCard.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import { getAllTopicSlugs, getTopicBySlug, getBuilds, getNotes } from '@/lib/microcms'
import { buildTopicPageSchemas } from '@/lib/schema'

export async function getStaticPaths() {
  const slugs = await getAllTopicSlugs()
  return slugs.map((item) => ({ params: { slug: item.slug }}))
}

const { slug } = Astro.params
const topic = await getTopicBySlug(slug)
if (!topic) return Astro.redirect('/404')
const [buildsRes, notesRes] = await Promise.all([getBuilds({ topicId: topic.id }), getNotes({ topicId: topic.id })])
const schemas = buildTopicPageSchemas(topic)
---

<BaseLayout title={topic.seoMeta?.metaTitle || topic.title} description={topic.seoMeta?.metaDescription || topic.intro} noindex={topic.seoMeta?.noIndex}>
  <Fragment slot="head"><JsonLd schemas={schemas} /></Fragment>
  <div class="section-shell topic-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Topics' }, { label: topic.title }]} />
    <header><p class="section-label">TOPIC</p><h1 class="page-title">{topic.title}</h1><p class="body-text">{topic.intro}</p></header>
    {topic.description && <div class="rich-content topic-page__description" set:html={topic.description} />}
    {buildsRes.contents.length > 0 && <section><p class="section-label">BUILDS</p><div class="topic-grid">{buildsRes.contents.map((build) => <BuildCard build={build} />)}</div></section>}
    {notesRes.contents.length > 0 && <section><p class="section-label">NOTES</p><div class="topic-grid">{notesRes.contents.map((note) => <NoteCard note={note} />)}</div></section>}
    {buildsRes.contents.length === 0 && notesRes.contents.length === 0 && <p class="body-text topic-page__empty">このトピックにはまだコンテンツがありません。</p>}
  </div>
</BaseLayout>

<style>
  .topic-page { padding-block: 80px 120px; }
  header { max-width: 800px; }
  .section-label { margin-bottom: 16px; }
  header .body-text { margin-top: 24px; }
  .topic-page__description { max-width: 760px; margin-top: 64px; }
  section { margin-top: 80px; }
  .topic-grid { display: grid; gap: 24px; }
  .topic-page__empty { margin-top: 64px; }
  @media (min-width: 768px) { .topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .topic-page { padding-block: 64px 80px; } }
</style>
