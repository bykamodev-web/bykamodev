---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BuildCard from '@/components/cards/BuildCard.astro'
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import { getBuilds } from '@/lib/microcms'
import { buildCollectionPageSchema } from '@/lib/schema'

const { contents: builds } = await getBuilds()

const collectionSchema = buildCollectionPageSchema({
  name: 'Builds',
  description: '実績・ケーススタディ一覧',
  url: 'https://bykamo.dev/builds',
})
---

<BaseLayout title="Builds" description="実績・ケーススタディ一覧。課題の整理から設計・実装・結果まで。">
  <Fragment slot="head">
    <JsonLd schemas={[collectionSchema]} />
  </Fragment>

  <div class="section-shell collection-page">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Builds' },
    ]} />

    <p class="section-label">BUILDS</p>
    <h1 class="page-title">公開できるかたちまで、実装を整える。</h1>
    <p class="body-text-lg collection-page__lead">課題の整理、設計、実装、運用まで。成果物だけでなく、その輪郭が伝わる単位でまとめています。</p>

    {builds.length > 0 ? (
      <div class="collection-grid">
        {builds.map((build, index) => (
          <div class="reveal" data-reveal style={`--delay:${index * 70}ms;`}>
            <BuildCard build={build} />
          </div>
        ))}
      </div>
    ) : (
      <p class="body-text">まだ公開されたBuildsはありません。</p>
    )}
  </div>
</BaseLayout>

<style>
  .collection-page { padding-block: 80px 120px; }
  .collection-page :global(.breadcrumbs) { margin-bottom: 40px; }
  .section-label { margin-bottom: 16px; }
  .page-title { max-width: 760px; }
  .collection-page__lead { max-width: 680px; margin-top: 24px; margin-bottom: 64px; }
  .collection-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 768px) { .collection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .collection-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
