---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import ArticleHero from '@/components/article/ArticleHero.astro'
import TopicChips from '@/components/article/TopicChips.astro'
import FactSheet from '@/components/article/FactSheet.astro'
import StorySection from '@/components/article/StorySection.astro'
import LinkRows from '@/components/article/LinkRows.astro'
import NoteList from '@/components/article/NoteList.astro'
import IndexReturn from '@/components/article/IndexReturn.astro'
import ContactCta from '@/components/sections/ContactCta.astro'
import { getAllBuildSlugs, getBuildBySlug, getOptimizedImageUrl } from '@/lib/microcms'
import { buildBuildPageSchemas } from '@/lib/schema'
import { formatDotDate, pad2 } from '@/components/article/format'

export async function getStaticPaths() {
  const slugs = await getAllBuildSlugs()
  return slugs.map((item) => ({ params: { slug: item.slug }}))
}

const { slug } = Astro.params
const build = await getBuildBySlug(slug)
if (!build) return Astro.redirect('/404')

const schemas = buildBuildPageSchemas(build)
const ogImage = build.seoMeta?.ogImage?.url || build.coverImage?.url
const status = build.statusLabel?.[0] || 'planning'
const cover = (width: number) => getOptimizedImageUrl(build.coverImage.url, { width, quality: 82, aspectRatio: '16:9' })
const coverSrcset = [960, 1440, 2000].map((width) => `${cover(width)} ${width}w`).join(', ')

const story = [
  { label: 'CHALLENGE', title: '課題', text: build.problem },
  { label: 'SOLUTION', title: '解決', text: build.solution },
  { label: 'OUTCOME', title: '結果・学び', text: build.outcome },
].filter((item): item is { label: string; title: string; text: string } => Boolean(item.text))
const links = build.links || []
const relatedNotes = build.relatedNotes || []
---

<BaseLayout class="page-flush" title={build.seoMeta?.metaTitle || build.title} description={build.seoMeta?.metaDescription || build.summary} ogImage={ogImage} noindex={build.seoMeta?.noIndex}>
  <Fragment slot="head"><JsonLd schemas={schemas} /></Fragment>
  <article class="article-page">
    <div class="section-shell">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Builds', href: '/builds' }, { label: build.title }]} />
      <ArticleHero
        index="01"
        label="BUILDS / CASE STUDY"
        title={build.title}
        lead={build.summary}
        meta={[{ k: 'STATUS', v: status.toUpperCase() }, { k: 'DATE', v: formatDotDate(build.publishedAt) }]}
      >
        <TopicChips topics={build.topics} />
      </ArticleHero>

      <figure class="article-cover">
        <div class="article-cover__clip" data-reveal="clip">
          <div class="article-cover__media">
            <img src={cover(1440)} srcset={coverSrcset} sizes="(max-width: 1400px) 94vw, 1320px" alt={build.title} width="1440" height="810" loading="eager" fetchpriority="high" decoding="async" />
          </div>
        </div>
        <figcaption class="article-cover__caption annotation"><span>FIG. 01 — COVER</span><span>{build.slug}</span></figcaption>
      </figure>

      <div class="article-body">
        <div class="article-body__rail"><FactSheet build={build} /></div>
        <div class="article-body__main">
          <div class="build-story">
            {story.map((item, index) => <StorySection index={pad2(index + 1)} label={item.label} title={item.title} text={item.text} />)}
          </div>

          {build.body && <div class="rich-content article-rich" set:html={build.body} />}

          {links.length > 0 && (
            <section class="article-block" aria-labelledby="build-links-title">
              <h2 id="build-links-title" class="annotation article-block__label">{pad2(story.length + 1)} — LINKS / 公開先</h2>
              <LinkRows links={links} />
            </section>
          )}
        </div>
      </div>

      {relatedNotes.length > 0 && (
        <section class="article-related" aria-labelledby="build-related-title">
          <div class="article-related__head" data-reveal>
            <h2 id="build-related-title" class="annotation">RELATED NOTES — 制作の記録</h2>
            <span class="annotation">{pad2(relatedNotes.length)}</span>
          </div>
          <NoteList notes={relatedNotes} headingLevel="h3" />
        </section>
      )}
    </div>

    <IndexReturn href="/builds" label="BACK TO INDEX — BUILDS" title="ほかのBuildsを見る" />
    <div class="article-page__cta"><ContactCta /></div>
  </article>
</BaseLayout>

<style>
  .article-page { padding-top: clamp(40px, 6vw, 80px); }

  .article-cover { margin-top: clamp(48px, 6vw, 88px); }

  .article-body {
    display: grid;
    gap: clamp(40px, 5vw, 64px);
    margin-top: clamp(56px, 7vw, 112px);
  }
  .article-body__main { min-width: 0; }
  .build-story { display: flex; flex-direction: column; }
  .build-story > :global(.story:last-child) { border-bottom: 1px solid var(--color-ink-violet); }

  .article-rich { margin-top: clamp(56px, 7vw, 96px); }

  .article-block { margin-top: clamp(56px, 7vw, 96px); }
  .article-block__label { margin-bottom: 20px; }

  .article-related { margin-top: clamp(80px, 10vw, 144px); }
  .article-related__head { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 16px; }

  .article-page__cta { margin-top: clamp(80px, 10vw, 160px); }

  @media (min-width: 1100px) {
    .article-body { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 32px); }
    .article-body__rail { grid-column: 1 / 4; }
    .article-body__main { grid-column: 5 / 13; }
  }
</style>
