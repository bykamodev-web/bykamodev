---
import type { BreadcrumbItem } from '@/types'
import { buildBreadcrumbSchema } from '@/lib/schema'

interface Props {
  items: BreadcrumbItem[]
}

const { items } = Astro.props
const schema = buildBreadcrumbSchema(items)
---

<nav aria-label="パンくずリスト" class="breadcrumbs">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">/</span>}
        {item.href && i < items.length - 1 ? (
          <a href={item.href}>
            {item.label}
          </a>
        ) : (
          <span>{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { margin-bottom: 40px; font-family: var(--font-supply); font-size: 14px; }
  ol { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  li { display: flex; align-items: center; gap: 6px; }
  a { border-bottom: 1px solid transparent; }
  a:hover { border-color: var(--color-ink-violet); }
</style>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
