---
import Icon from '@/components/icons/Icons.astro'

/** Hairline link whose underline redraws on hover and whose arrow exits right / enters left. */
interface Props {
  href: string
  class?: string
  reload?: boolean
}

const { href, class: className, reload = false } = Astro.props
---

<a href={href} class:list={['group hairline-link arrow-link', className]} data-astro-reload={reload || undefined}>
  <slot />
  <span class="arrow-link__icon"><Icon name="arrow-right" size={18} class="hover-arrow" /></span>
</a>

<style>
  .arrow-link__icon { display: inline-flex; overflow: hidden; }
  /* 44px hit area without moving the drawn underline. */
  .arrow-link { position: relative; }
  .arrow-link::after { content: ""; position: absolute; inset: -10px -6px -8px; }
</style>
