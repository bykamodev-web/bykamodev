---
import BuildCard from '@/components/cards/BuildCard.astro'
import Icon from '@/components/icons/Icons.astro'
import type { Build } from '@/types'

interface Props { builds: Build[] }
const { builds } = Astro.props
---

{builds.length > 0 && (
  <section class="builds-section">
    <div class="section-shell">
      <div class="section-heading reveal" data-reveal>
        <p class="section-label">SELECTED BUILDS</p>
        <div>
          <h2 class="page-title">実装を、<br />使われる構造にする。</h2>
          <p class="body-text">課題の整理から設計、実装、運用まで。成果物の外側にある判断も含めて残しています。</p>
        </div>
      </div>

      <div class="builds-grid">
        {builds.map((build, index) => (
          <div class="reveal" data-reveal style={`--delay:${index * 90}ms;`}>
            <BuildCard build={build} />
          </div>
        ))}
      </div>

      <div class="section-action reveal" data-reveal>
        <a href="/builds" class="group hairline-link">すべてのBuildsを見る <Icon name="arrow-right" size={18} class="hover-arrow" /></a>
      </div>
    </div>
  </section>
)}

<style>
  .builds-section { padding: 120px 0; }
  .section-heading { display: grid; gap: 24px; margin-bottom: 64px; }
  .section-heading > div { display: grid; gap: 24px; }
  .section-heading .body-text { max-width: 570px; }
  .builds-grid { display: grid; gap: 24px; }
  .section-action { margin-top: 40px; }
  @media (min-width: 768px) {
    .section-heading { grid-template-columns: minmax(170px, .36fr) minmax(0, 1fr); }
    .builds-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) { .builds-section { padding: 80px 0; } }
</style>
