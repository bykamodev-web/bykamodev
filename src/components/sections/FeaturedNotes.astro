---
import Icon from '@/components/icons/Icons.astro'
import type { Note } from '@/types'

interface Props { notes: Note[] }
const { notes } = Astro.props

const kindLabels: Record<string, string> = {
  log: 'Log',
  howto: 'How-to',
  'case-study': 'Case Study',
  thinking: 'Thinking',
}
---

{notes.length > 0 && (
  <section class="notes-band">
    <div class="section-shell notes-band__inner">
      <div class="notes-band__intro reveal" data-reveal>
        <p class="section-label">NOTES</p>
        <h2>設計判断を、<br />次の一手のために残す。</h2>
        <p>開発ログ、技術比較、プロダクトの考え方。作ったものの背景まで、短く記録しています。</p>
      </div>

      <div class="notes-list">
        {notes.map((note, index) => {
          const kind = note.kind?.[0]
          const publishedDate = note.publishedAt
            ? new Date(note.publishedAt).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })
            : 'Draft'
          return (
            <a href={`/notes/${note.slug}`} class="notes-list__item reveal" data-reveal style={`--delay:${index * 90}ms;`}>
              <div class="notes-list__meta"><span>{publishedDate}</span>{kind && <span>{kindLabels[kind] || kind}</span>}</div>
              <div>
                <h3>{note.title}</h3>
                <p>{note.excerpt}</p>
              </div>
              <Icon name="arrow-right" size={20} class="hover-arrow" />
            </a>
          )
        })}
      </div>

      <a href="/notes" class="group notes-band__action reveal" data-reveal>すべてのNotesを見る <Icon name="arrow-right" size={18} class="hover-arrow" /></a>
    </div>
  </section>
)}

<style>
  .notes-band { background: var(--color-deep-teal); color: var(--color-cream-paper); }
  .notes-band__inner { padding-block: 104px; }
  .notes-band__intro { display: grid; gap: 24px; max-width: 700px; }
  .notes-band .section-label { color: var(--color-butter-yellow); }
  h2 { font-size: clamp(40px, 4.4vw, 48px); font-weight: 700; line-height: 1.27; }
  .notes-band__intro > p:last-child { font-size: 20px; line-height: 1.6; max-width: 610px; }
  .notes-list { margin-top: 64px; border-top: 1px solid var(--color-cream-paper); }
  .notes-list__item {
    display: grid;
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-cream-paper);
    transition: padding 180ms ease, background-color 180ms ease;
  }
  .notes-list__item:hover { padding-inline: 16px; background: rgba(255, 252, 247, .08); }
  .notes-list__meta { display: flex; gap: 16px; font-family: var(--font-supply); font-size: 14px; color: var(--color-butter-yellow); }
  h3 { font-size: 24px; font-weight: 700; line-height: 1.4; }
  .notes-list__item p { margin-top: 8px; font-size: 16px; line-height: 1.6; }
  .notes-band__action { display: inline-flex; gap: 12px; align-items: center; margin-top: 40px; border-bottom: 1px solid var(--color-cream-paper); padding-bottom: 2px; color: var(--color-cream-paper); font-size: 16px; font-weight: 700; }
  @media (min-width: 768px) {
    .notes-list__item { grid-template-columns: 180px minmax(0, 1fr) auto; align-items: center; gap: 40px; }
  }
  @media (max-width: 767px) { .notes-band__inner { padding-block: 80px; } }
  @media (prefers-reduced-motion: reduce) { .notes-list__item { transition: none; } .notes-list__item:hover { padding-inline: 0; } }
</style>
