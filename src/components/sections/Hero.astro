---
import Icon from '@/components/icons/Icons.astro'
---

<section class="hero-shell">
  <div class="section-shell hero-layout">
    <div class="hero-copy reveal" data-reveal>
      <p class="hero-kicker"><span></span>Independent developer / KAMO</p>
      <h1 class="hero-title">AIとコードで、<br />複雑な仕事を<br />組み直す。</h1>
      <p class="body-text hero-description">
        曖昧な要件をほどき、使い続けられるプロダクトと自動化の仕組みに変えていきます。
      </p>
      <div class="hero-actions">
        <a href="/contact" class="group btn-primary">
          制作について相談する
          <Icon name="arrow-right" size={18} class="hover-arrow" />
        </a>
        <a href="/builds" class="group btn-ghost">
          Buildsを見る
          <Icon name="arrow-right" size={18} class="hover-arrow" />
        </a>
      </div>
    </div>

    <div class="hero-visual reveal" data-reveal style="--delay:140ms;">
      <div class="hero-illustration" aria-label="要件からプロダクトへ変換するワークフローの図解" role="img">
        <svg viewBox="0 0 610 550" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="61" y="58" width="406" height="345" fill="#fff" stroke="#0d0129" stroke-width="1.5" />
          <path d="M61 107H467" stroke="#0d0129" stroke-width="1.5" />
          <circle cx="86" cy="82" r="6" fill="#fae59b" stroke="#0d0129" stroke-width="1.5" />
          <path d="M105 82H224" stroke="#0d0129" stroke-width="1.5" />
          <rect x="92" y="142" width="148" height="182" fill="#fffcf7" stroke="#0d0129" stroke-width="1.5" />
          <path d="M112 173H204M112 195H216M112 217H185" stroke="#0d0129" stroke-width="1.5" />
          <rect x="112" y="250" width="97" height="38" fill="#fae59b" stroke="#0d0129" stroke-width="1.5" />
          <path d="M132 269H190" stroke="#0d0129" stroke-width="1.5" />
          <rect x="273" y="142" width="155" height="116" fill="#19615c" stroke="#0d0129" stroke-width="1.5" />
          <path d="M298 228V184M326 228V169M354 228V194M382 228V157" stroke="#fae59b" stroke-width="12" />
          <path d="M273 292H428" stroke="#0d0129" stroke-width="1.5" />
          <circle cx="298" cy="325" r="14" fill="#fae59b" stroke="#0d0129" stroke-width="1.5" />
          <circle cx="350" cy="325" r="14" fill="#fff" stroke="#0d0129" stroke-width="1.5" />
          <circle cx="402" cy="325" r="14" fill="#fae59b" stroke="#0d0129" stroke-width="1.5" />
          <path d="M312 325H336M364 325H388" stroke="#0d0129" stroke-width="1.5" />
          <path d="M196 372H335" stroke="#0d0129" stroke-width="1.5" stroke-dasharray="5 5" />
          <path d="M335 372L324 366V378L335 372Z" fill="#0d0129" />
          <g class="diagram-document">
            <rect x="371" y="249" width="168" height="207" fill="#fff" stroke="#0d0129" stroke-width="1.5" />
            <path d="M398 284H509M398 310H492M398 336H516M398 362H465" stroke="#0d0129" stroke-width="1.5" />
            <rect x="398" y="390" width="93" height="35" fill="#fae59b" stroke="#0d0129" stroke-width="1.5" />
          </g>
          <circle cx="33" cy="180" r="7" fill="#fae59b" />
          <circle cx="525" cy="92" r="5" fill="#19615c" />
          <circle cx="532" cy="469" r="7" fill="#fae59b" />
          <path d="M526 153L544 171M544 153L526 171" stroke="#0d0129" stroke-width="1.5" />
          <path d="M75 454L92 471M92 454L75 471" stroke="#19615c" stroke-width="1.5" />
        </svg>
      </div>
      <p class="hero-visual__caption">FROM BRIEF → WORKING SYSTEM</p>
    </div>
  </div>
</section>

<style>
  .hero-shell {
    overflow: clip;
    padding: 88px 0 104px;
    min-height: calc(100svh - 72px);
    display: grid;
    align-items: center;
  }
  .hero-layout {
    display: grid;
    align-items: center;
    gap: 56px;
  }
  .hero-copy { max-width: 650px; }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    font-size: 16px;
    font-weight: 700;
  }
  .hero-kicker span { width: 8px; height: 8px; background: var(--color-butter-yellow); border: 1px solid var(--color-ink-violet); }
  .hero-description { max-width: 590px; margin-top: 32px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 40px; }
  .hero-visual { position: relative; }
  .hero-illustration { width: min(100%, 610px); margin-inline: auto; }
  .hero-illustration svg { width: 100%; height: auto; }
  .hero-visual__caption {
    margin-top: 10px;
    font-family: var(--font-supply);
    font-size: 14px;
    color: var(--color-ink-violet);
  }
  .diagram-document { transform-origin: 455px 350px; animation: diagramFloat 4.5s ease-in-out infinite; }
  @keyframes diagramFloat { 50% { transform: translate(0, -10px); } }
  @media (min-width: 960px) {
    .hero-layout { grid-template-columns: minmax(0, 1.05fr) minmax(460px, .95fr); gap: 64px; }
    .hero-visual { transform: translateX(24px); }
  }
  @media (max-width: 767px) {
    .hero-shell { min-height: auto; padding: 64px 0 72px; }
    .hero-layout { gap: 56px; }
    .hero-actions { flex-direction: column; }
    .hero-visual { width: calc(100% + 16px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .diagram-document { animation: none; }
  }
</style>
