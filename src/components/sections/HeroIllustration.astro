---
/**
 * "Reassembly" schematic. Every `[data-part]` carries its scattered offset (--from-x/-y/-r) and
 * snaps into its slot when the root gains `.is-assembled` (motion/hero-assembly.ts).
 * Drawn on an 8px grid at 640×576, 1.5px strokes, fills limited to cream / white / yellow / teal.
 */
interface Props {
  mode?: 'assemble' | 'scattered'
  class?: string
  label?: string
}

const {
  mode = 'assemble',
  class: className,
  label = '散らばった要件の部品が、ブラウザ・チャート・書類・ワークフローとしてひとつのシステムに組み上がる図解',
} = Astro.props

const INK = '#0d0129'
const YELLOW = '#fae59b'
const TEAL = '#19615c'
const CREAM = '#fffcf7'
const WHITE = '#ffffff'

const part = (x: number, y: number, r: number, i: number) =>
  `--from-x:${x}px;--from-y:${y}px;--from-r:${r}deg;--i:${i};`
const depth = (d: number) => `--d:${d}px;`
const bars = [24, 40, 32, 56, 48, 64, 72]
---

<div
  class:list={['hero-illustration', className]}
  data-assembly
  data-loop
  data-mode={mode}
  role="img"
  aria-label={label}
>
  <svg viewBox="0 0 640 576" fill="none" stroke={INK} stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- Sheet: registration marks, dimension lines, callout -->
    <g class="sheet" data-depth style={depth(2)}>
      <path class="draw" pathLength="1" d="M16 40V16H40M600 16H624V40M624 536V560H600M40 560H16V536" />
      <path class="draw" pathLength="1" d="M96 40H496M96 34V46M496 34V46" />
      <rect x="272" y="33" width="48" height="14" fill={CREAM} stroke="none" />
      <text x="296" y="43.5" text-anchor="middle">W 400</text>
      <path class="draw" pathLength="1" d="M64 72V376M58 72H70M58 376H70" />
      <rect x="57" y="200" width="14" height="48" fill={CREAM} stroke="none" />
      <text x="0" y="0" text-anchor="middle" transform="translate(67 224) rotate(-90)">H 304</text>
      <path class="draw" pathLength="1" d="M472 152L512 112H568" style="--draw-delay:520ms;" />
      <text x="520" y="104">SYSTEM</text>
      <rect x="468" y="148" width="8" height="8" fill={YELLOW} />
    </g>

    <!-- Browser window with the slots its parts snap into -->
    <g data-depth style={depth(4)}>
      <g data-part style={part(-28, 36, -3, 1)}>
        <rect x="96" y="72" width="400" height="304" fill={WHITE} />
        <path d="M96 104H496M192 104V376" />
        <rect x="112" y="84" width="8" height="8" fill={YELLOW} />
        <rect x="128" y="84" width="8" height="8" fill={WHITE} />
        <rect x="144" y="84" width="8" height="8" fill={WHITE} />
        <rect x="168" y="82" width="208" height="12" fill={CREAM} />
        <text x="176" y="91">bykamo.dev / system</text>
        <path d="M456 85H480M456 91H480" />
        <rect x="104" y="120" width="80" height="16" fill={YELLOW} />
        <path d="M112 128H160M112 152H168M112 176H152M112 200H164M112 224H144" />
        <rect x="112" y="336" width="24" height="24" fill={CREAM} />
        <path d="M144 344H176M144 352H168" />
        <path d="M216 124H336M216 136H280" />
        <rect class="slot" x="216" y="152" width="256" height="120" />
        <rect class="slot" x="216" y="288" width="112" height="56" />
        <rect class="slot" x="344" y="288" width="80" height="56" />
      </g>
    </g>

    <!-- Chart panel -->
    <g data-depth style={depth(9)}>
      <g data-part style={part(84, -72, 9, 2)}>
        <rect x="216" y="152" width="256" height="120" fill={TEAL} />
        <text class="on-teal" x="232" y="172">SIGNAL</text>
        <path d="M232 256H456" stroke={CREAM} />
        {bars.map((height, index) => (
          <rect
            class="bar"
            style={`--b:${index};`}
            x={240 + index * 32}
            y={256 - height}
            width="16"
            height={height}
            fill={YELLOW}
          />
        ))}
        <path class="draw" pathLength="1" style="--draw-delay:700ms;" d="M248 212L280 196L312 204L344 180L376 188L408 172L440 164" stroke={CREAM} />
        <rect x="436" y="160" width="8" height="8" fill={YELLOW} />
      </g>
    </g>

    <!-- KPI cards -->
    <g data-depth style={depth(6)}>
      <g data-part style={part(-64, 80, -11, 3)}>
        <rect x="216" y="288" width="112" height="56" fill={CREAM} />
        <text x="228" y="306">LLM</text>
        <rect x="228" y="318" width="56" height="12" fill={YELLOW} />
        <path d="M292 324H316" />
      </g>
      <g data-part style={part(56, 104, 8, 4)}>
        <rect x="344" y="288" width="80" height="56" fill={WHITE} />
        <text x="356" y="306">AUTO</text>
        <rect x="356" y="320" width="56" height="8" fill={WHITE} />
        <rect x="356" y="320" width="34" height="8" fill={TEAL} />
      </g>
    </g>

    <!-- Workflow nodes + marching flow into the brief -->
    <g data-depth style={depth(5)}>
      <g data-part style={part(-44, 64, -5, 5)}>
        <path class="draw" pathLength="1" style="--draw-delay:560ms;" d="M128 376V432" />
        <path class="draw" pathLength="1" style="--draw-delay:640ms;" d="M144 448H200M232 448H288" />
        <circle cx="128" cy="448" r="16" fill={YELLOW} />
        <rect class="pulse" x="192" y="424" width="48" height="48" stroke={TEAL} />
        <rect x="200" y="432" width="32" height="32" fill={WHITE} />
        <path d="M216 440L224 448L216 456L208 448Z" fill={TEAL} />
        <circle cx="304" cy="448" r="16" fill={TEAL} />
        <path class="flow" d="M320 448H428" stroke-dasharray="4 4" />
        <path d="M440 448L430 443V453Z" fill={INK} />
        <text x="128" y="488" text-anchor="middle">INPUT</text>
        <text x="216" y="488" text-anchor="middle">MODEL</text>
        <text x="304" y="488" text-anchor="middle">OUTPUT</text>
      </g>
    </g>

    <!-- The brief: a document that floats once assembled -->
    <g data-depth style={depth(12)}>
      <path class="slot" d="M440 304H576L600 328V520H440Z" />
      <g data-part style={part(104, 44, 13, 6)}>
        <g class="float">
          <path d="M440 304H576L600 328V520H440Z" fill={WHITE} />
          <path d="M576 304V328H600Z" fill={CREAM} />
          <rect x="456" y="320" width="56" height="16" fill={YELLOW} />
          <text x="464" y="331.5">BRIEF</text>
          <path d="M456 360H568M456 376H584M456 392H544" />
          <rect x="456" y="412" width="10" height="10" fill={YELLOW} />
          <rect x="456" y="436" width="10" height="10" fill={YELLOW} />
          <rect x="456" y="460" width="10" height="10" fill={WHITE} />
          <path d="M458.5 417L460.5 419.5L464 414.5M458.5 441L460.5 443.5L464 438.5" />
          <path d="M476 417H560M476 441H576M476 465H544M456 496H512" />
          <rect x="544" y="484" width="40" height="24" fill={TEAL} />
          <path d="M556 496L561 501L572 490" stroke={CREAM} />
        </g>
      </g>
    </g>

    <!-- Version tag -->
    <g data-depth style={depth(10)}>
      <g data-part style={part(36, 60, 18, 7)}>
        <path class="draw" pathLength="1" style="--draw-delay:820ms;" d="M384 504V456" />
        <rect x="352" y="504" width="64" height="24" fill={WHITE} />
        <rect x="360" y="512" width="8" height="8" fill={YELLOW} />
        <text x="376" y="520">v1.0</text>
      </g>
    </g>

    <!-- Loose parts -->
    <g data-depth style={depth(14)}>
      <g data-part style={part(-72, -48, 45, 8)}>
        <rect x="528" y="176" width="16" height="16" fill={YELLOW} />
        <path d="M560 232L572 244M572 232L560 244" stroke={TEAL} />
        <rect x="88" y="512" width="8" height="8" fill={TEAL} stroke="none" />
      </g>
    </g>
  </svg>
</div>

<style>
  .hero-illustration {
    --px: 0;
    --py: 0;
    position: relative;
  }

  svg { width: 100%; height: auto; overflow: visible; }

  text {
    fill: var(--color-ink-violet);
    stroke: none;
    font-family: var(--font-supply);
    font-size: 8.5px;
    letter-spacing: 0.08em;
  }

  text.on-teal { fill: var(--color-cream-paper); }

  :is(rect, path, circle):not(.draw, .flow, .slot) { vector-effect: non-scaling-stroke; }

  .slot { stroke-dasharray: 3 5; opacity: 0.5; }

  [data-depth] {
    transform: translate(calc(var(--px) * var(--d, 0px)), calc(var(--py) * var(--d, 0px)));
  }

  [data-part] {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transition: transform var(--dur-3) var(--ease-snap) calc(var(--i, 0) * var(--stagger));
  }

  .bar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition: transform var(--dur-3) var(--ease-out) calc(420ms + var(--b) * 50ms);
  }

  .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur-3) var(--ease-in-out) var(--draw-delay, 160ms);
  }

  :global(html.js) [data-mode="assemble"]:not(.is-assembled) [data-part],
  [data-mode="scattered"]:not(.is-assembled) [data-part] {
    transform: translate(var(--from-x), var(--from-y)) rotate(var(--from-r));
  }

  :global(html.js) [data-mode="assemble"]:not(.is-assembled) .bar { transform: scaleY(0); }
  :global(html.js) [data-mode="assemble"]:not(.is-assembled) .draw { stroke-dashoffset: 1; }

  .is-jolt [data-part] {
    transform: translate(calc(var(--from-x) * 0.16), calc(var(--from-y) * 0.16)) rotate(calc(var(--from-r) * 0.35));
    transition-duration: 160ms;
    transition-delay: 0ms;
  }

  .pulse { opacity: 0; transform-box: fill-box; transform-origin: 50% 50%; }
  .is-settled .pulse { animation: node-pulse 2.4s var(--ease-out) infinite; }
  .is-settled .flow { animation: flow-march 0.9s linear infinite; }
  .is-settled .float { animation: doc-float 4.8s var(--ease-in-out) infinite; }
  .is-paused * { animation-play-state: paused !important; }

  @keyframes node-pulse {
    0% { opacity: 0.9; transform: scale(0.72); }
    100% { opacity: 0; transform: scale(1.3); }
  }

  @keyframes flow-march { to { stroke-dashoffset: -16; } }
  @keyframes doc-float { 50% { transform: translateY(-8px); } }

  @media (prefers-reduced-motion: reduce) {
    [data-mode="assemble"] [data-part],
    [data-mode="assemble"] .bar,
    [data-depth] { transform: none !important; transition: none !important; }
    .draw { stroke-dashoffset: 0 !important; transition: none !important; }
    .pulse, .flow, .float { animation: none !important; }
  }
</style>
