---
/**
 * Name and e-mail. These inputs are read only by the final send to /api/contact:
 * the chat and summary requests have no field for them and reject any extra key.
 */
---

<fieldset class="contact-box">
  <legend class="annotation contact-box__legend">CONTACT — NOT SENT TO AI</legend>
  <p class="contact-box__note">
    この欄のお名前とメールアドレスは AI に送信されません。「送信する」を押したときに、bykamo.dev に届くメールにだけ記載されます。
  </p>

  <div class="field">
    <label for="name" class="form-label"><span>お名前</span><span class="form-tag" aria-hidden="true">REQUIRED</span></label>
    <input
      type="text"
      id="name"
      name="name"
      required
      maxlength="100"
      placeholder="山田太郎"
      autocomplete="name"
      aria-describedby="name-error"
      class="form-input"
    />
    <p class="form-error" id="name-error" data-error="name"></p>
  </div>

  <div class="field">
    <label for="email" class="form-label"><span>メールアドレス</span><span class="form-tag" aria-hidden="true">REQUIRED</span></label>
    <input
      type="email"
      id="email"
      name="email"
      required
      placeholder="you@example.com"
      autocomplete="email"
      aria-describedby="email-error"
      class="form-input"
    />
    <p class="form-error" id="email-error" data-error="email"></p>
  </div>
</fieldset>
