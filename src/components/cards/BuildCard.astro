---
import type { Build } from '@/types'
import { getOptimizedImageUrl } from '@/lib/microcms'
import Icon from '@/components/icons/Icons.astro'

interface Props { build: Build }
const { build } = Astro.props
const status = build.statusLabel?.[0] || 'planning'
const imageSm = getOptimizedImageUrl(build.coverImage.url, { width: 480, quality: 72, aspectRatio: '16:9' })
const imageLg = getOptimizedImageUrl(build.coverImage.url, { width: 800, quality: 78, aspectRatio: '16:9' })
---

<a href={`/builds/${build.slug}`} class="group build-card-link">
  <article class="build-card">
    <figure class="build-card__image">
      <img src={imageSm} srcset={`${imageSm} 480w, ${imageLg} 800w`} sizes="(max-width: 767px) calc(100vw - 48px), 400px" alt={build.title} loading="lazy" />
    </figure>
    <div class="build-card__content">
      <div class="build-card__meta"><span class={`badge badge-${status}`}>{status}</span>{build.topics?.slice(0, 1).map((topic) => <span class="caption">{topic.title}</span>)}</div>
      <h3>{build.title}</h3>
      <p>{build.summary}</p>
      <div class="build-card__footer">
        {build.stack && build.stack.length > 0 && <span>{build.stack.slice(0, 3).map((item) => item.name).join(' / ')}</span>}
        <Icon name="arrow-right" size={18} class="hover-arrow" />
      </div>
    </div>
  </article>
</a>

<style>
  .build-card-link { display: block; height: 100%; }
  .build-card { display: flex; flex-direction: column; height: 100%; border: 1px solid var(--color-ink-violet); background: var(--color-pure-white); transition: transform 180ms ease; }
  .build-card-link:hover .build-card { transform: translate(-3px, -3px); }
  .build-card__image { border-bottom: 1px solid var(--color-ink-violet); background: var(--color-cream-paper); }
  .build-card__image img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .build-card__content { display: flex; flex: 1; flex-direction: column; padding: 24px; }
  .build-card__meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }
  h3 { font-size: 24px; font-weight: 700; line-height: 1.4; }
  p { margin-top: 16px; font-size: 16px; line-height: 1.6; }
  .build-card__footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: auto; padding-top: 24px; border-top: 1px solid var(--color-ink-violet); font-family: var(--font-supply); font-size: 14px; line-height: 1.4; }
  @media (prefers-reduced-motion: reduce) { .build-card { transition: none; } .build-card-link:hover .build-card { transform: none; } }
</style>
