---
const navItems = [
  { label: 'Builds', href: '/builds' },
  { label: 'Notes', href: '/notes' },
  { label: 'About', href: '/about' },
]

const currentPath = Astro.url.pathname
---

<header class="site-header">
  <div class="section-shell site-header__inner">
    <a href="/" class="site-brand" aria-label="bykamo.dev ホーム">
      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
        <path d="M4 9.5 15 3l11 6.5v11L15 27 4 20.5v-11Z" stroke="currentColor" stroke-width="1.5" />
        <path d="M10 11.5h10M10 15h10M10 18.5h6" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <span>bykamo.dev</span>
    </a>

    <nav class="site-nav" aria-label="メインナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['site-nav__link', currentPath.startsWith(item.href) && 'is-current']}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact" class="btn-nav">相談する</a>
    </nav>

    <button id="mobile-menu-btn" class="menu-button" aria-label="メニュー" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="モバイルナビゲーション">
    <div class="section-shell mobile-menu__inner">
      {navItems.map((item) => (
        <a href={item.href} class:list={['mobile-menu__link', currentPath.startsWith(item.href) && 'is-current']}>
          {item.label}
        </a>
      ))}
      <a href="/contact" class="btn-nav">相談する</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid var(--color-ink-violet);
    background: var(--color-cream-paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    gap: 24px;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink-violet);
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .site-nav__link,
  .mobile-menu__link {
    border-bottom: 1px solid transparent;
    color: var(--color-ink-violet);
    font-size: 16px;
    line-height: 1.4;
  }

  .site-nav__link:hover,
  .site-nav__link.is-current,
  .mobile-menu__link.is-current {
    border-color: var(--color-ink-violet);
  }

  .menu-button,
  .mobile-menu { display: none; }

  @media (max-width: 767px) {
    .site-header__inner { min-height: 64px; }
    .site-nav { display: none; }
    .menu-button {
      display: grid;
      width: 40px;
      height: 40px;
      padding: 10px;
      border: 1px solid var(--color-ink-violet);
      background: transparent;
      gap: 6px;
      align-content: center;
    }
    .menu-button span {
      display: block;
      width: 100%;
      height: 1px;
      background: var(--color-ink-violet);
    }
    .mobile-menu {
      border-top: 1px solid var(--color-ink-violet);
      background: var(--color-cream-paper);
    }
    .mobile-menu.is-open { display: block; }
    .mobile-menu__inner {
      display: grid;
      gap: 16px;
      padding-block: 24px;
    }
    .mobile-menu .btn-nav { width: max-content; margin-top: 8px; }
  }
</style>

<script is:inline>
  (() => {
    const button = document.getElementById('mobile-menu-btn')
    const menu = document.getElementById('mobile-menu')
    if (!button || !menu) return

    button.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open')
      button.setAttribute('aria-expanded', String(isOpen))
    })
  })()
</script>
