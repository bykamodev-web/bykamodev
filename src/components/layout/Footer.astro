---
interface Props {
  xUrl?: string
  githubUrl?: string
}

const { xUrl, githubUrl } = Astro.props
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="section-shell site-footer__inner">
    <div>
      <a href="/" class="footer-brand">bykamo.dev</a>
      <p>AIとコードで、情報・運用・体験を組み直す。</p>
    </div>

    <div class="footer-links">
      <nav aria-label="フッターナビゲーション">
        <a href="/builds">Builds</a>
        <a href="/notes">Notes</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
      {(xUrl || githubUrl) && (
        <div class="footer-socials">
          {xUrl && <a href={xUrl} target="_blank" rel="noopener noreferrer">X</a>}
          {githubUrl && <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>}
        </div>
      )}
    </div>
  </div>
  <div class="section-shell site-footer__meta">© {year} bykamo.dev</div>
</footer>

<style>
  .site-footer {
    margin-top: 120px;
    border-top: 1px solid var(--color-ink-violet);
    background: var(--color-cream-paper);
  }
  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding-block: 64px;
  }
  .footer-brand {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 24px;
    font-weight: 700;
  }
  p { max-width: 440px; font-size: 16px; line-height: 1.6; }
  .footer-links { display: grid; justify-items: start; gap: 24px; }
  nav, .footer-socials { display: flex; flex-wrap: wrap; gap: 16px 24px; }
  nav a, .footer-socials a { border-bottom: 1px solid transparent; font-size: 16px; }
  nav a:hover, .footer-socials a:hover { border-color: var(--color-ink-violet); }
  .site-footer__meta {
    border-top: 1px solid var(--color-ink-violet);
    padding-block: 16px;
    font-family: var(--font-supply);
    font-size: 14px;
  }
  @media (max-width: 767px) {
    .site-footer { margin-top: 80px; }
    .site-footer__inner { flex-direction: column; padding-block: 40px; }
  }
</style>
