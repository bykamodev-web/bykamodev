---
import type { TocHeading } from '@/components/article/headings'
import { pad2 } from '@/components/article/format'

/**
 * Table of contents from the article's h2s (extracted server-side, so it works without JS).
 * ≥1100px: sticky rail list. Below: a collapsible <details>. Active-section highlight: motion/toc.ts.
 */
interface Props { headings: TocHeading[] }

const { headings } = Astro.props
---

{headings.length > 1 && (
  <div class="toc" data-toc>
    <nav class="toc__rail" aria-label="目次">
      <p class="toc__head annotation"><span>CONTENTS</span><span>{pad2(headings.length)}</span></p>
      <ol class="toc__list">
        {headings.map((heading, index) => (
          <li><a href={`#${heading.id}`} class="toc__link" data-toc-link><span class="toc__num">{pad2(index + 1)}</span><span class="toc__text">{heading.text}</span></a></li>
        ))}
      </ol>
      <span class="toc__progress" aria-hidden="true"><span data-toc-progress></span></span>
    </nav>

    <details class="toc__details">
      <summary class="toc__summary annotation">
        <span>CONTENTS — 目次</span><span class="toc__count">{pad2(headings.length)}</span>
        <span class="toc__plus" aria-hidden="true"></span>
      </summary>
      <nav aria-label="目次">
        <ol class="toc__list">
          {headings.map((heading, index) => (
            <li><a href={`#${heading.id}`} class="toc__link" data-toc-link><span class="toc__num">{pad2(index + 1)}</span><span class="toc__text">{heading.text}</span></a></li>
          ))}
        </ol>
      </nav>
    </details>
  </div>
)}

<style>
  .toc { font-size: 14px; }

  .toc__rail { display: none; }

  .toc__head {
    display: flex;
    justify-content: space-between;
    padding-block: 14px;
    border-bottom: 1px solid var(--color-ink-violet);
  }

  .toc__list { counter-reset: none; }
  .toc__list li { border-bottom: 1px solid rgb(13 1 41 / 0.16); }

  .toc__link {
    position: relative;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 10px;
    isolation: isolate;
    padding: 11px 8px 11px 12px;
    line-height: 1.55;
    transition: color var(--dur-1) var(--ease-out);
  }
  .toc__link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-butter-yellow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .toc__link:hover::before,
  .toc__link:focus-visible::before { transform: scaleX(1); }

  .toc__num {
    padding-top: 2px;
    font-family: var(--font-supply);
    font-size: 11px;
    letter-spacing: 0.04em;
    opacity: 0.6;
  }
  .toc__text { overflow-wrap: anywhere; text-wrap: pretty; }

  .toc__link.is-active { font-weight: 700; }
  .toc__link.is-active .toc__num { opacity: 1; }
  .toc__link.is-active { box-shadow: inset 3px 0 0 var(--color-ink-violet); }

  .toc__progress { display: block; height: 2px; margin-top: -1px; background: rgb(13 1 41 / 0.12); }
  .toc__progress span {
    display: block;
    height: 100%;
    background: var(--color-ink-violet);
    transform: scaleX(var(--toc-progress, 0));
    transform-origin: left;
  }

  /* Mobile / tablet: collapsible. */
  .toc__details { border-block: 1px solid var(--color-ink-violet); }
  .toc__summary {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    cursor: pointer;
    list-style: none;
  }
  .toc__summary::-webkit-details-marker { display: none; }
  .toc__count { margin-left: auto; opacity: 0.6; }
  .toc__plus { position: relative; width: 14px; height: 14px; flex: none; }
  .toc__plus::before,
  .toc__plus::after {
    content: "";
    position: absolute;
    inset: 6px 0 auto;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .toc__plus::after { transform: rotate(90deg); }
  details[open] .toc__plus::after { transform: rotate(0deg); }
  .toc__details nav { padding-bottom: 12px; }
  .toc__details .toc__list li:last-child { border-bottom: 0; }
  .toc__details .toc__link { padding-block: 10px; min-height: 44px; }

  @media (min-width: 1100px) {
    .toc { position: sticky; top: calc(var(--header-h) + 24px); max-height: calc(100vh - var(--header-h) - 48px); overflow-y: auto; scrollbar-width: thin; }
    .toc__rail { display: block; border-top: 1px solid var(--color-ink-violet); }
    .toc__details { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc__link::before, .toc__plus::before, .toc__plus::after { transition: none; }
  }
</style>
