---
import type { Topic } from '@/types'

/** `#topic` chips linking to topic pages. Renders nothing when there are no titled topics. */
interface Props { topics?: Topic[] }

const topics = (Astro.props.topics || []).filter((topic) => topic?.title && topic?.slug)
---

{topics.length > 0 && (
  <ul class="topic-chips" aria-label="トピック">
    {topics.map((topic) => <li><a href={`/topics/${topic.slug}`} class="topic-chip">{topic.title}</a></li>)}
  </ul>
)}

<style>
  .topic-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .topic-chip {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 6px 12px;
    border: 1px solid var(--color-ink-violet);
    background: var(--color-pure-white);
    font-size: 14px;
    font-weight: 700;
    transition: background-color var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out), box-shadow var(--dur-1) var(--ease-out);
  }
  .topic-chip::before { content: "#"; margin-right: 4px; font-family: var(--font-supply); font-weight: 400; opacity: 0.6; }
  .topic-chip:hover,
  .topic-chip:focus-visible { background: var(--color-butter-yellow); transform: translate(-2px, -2px); box-shadow: 2px 2px 0 0 var(--color-ink-violet); }
  @media (prefers-reduced-motion: reduce) {
    .topic-chip { transition: none; }
    .topic-chip:hover, .topic-chip:focus-visible { transform: none; }
  }
</style>
